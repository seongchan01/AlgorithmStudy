import java.io.BufferedReader;
import java.io.InputStreamReader;
import java.util.StringTokenizer;
 
class Solution
{

     static int N;

    public static void main(String args[]) throws Exception
    {

        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        StringBuilder sb = new StringBuilder();
         
        int T = Integer.parseInt(br.readLine());
         
        for (int t = 1; t <= T; t++) {
            N = Integer.parseInt(br.readLine()); // 나무 개수
            int[] arr = new int[N]; // 나무 배열
            int max = Integer.MIN_VALUE; // 나무 키 최대값
            int answer = 0;
            StringTokenizer st = new StringTokenizer(br.readLine());

            for (int i = 0; i < N; i++) {
                arr[i] = Integer.parseInt(st.nextToken());
                max = Math.max(max, arr[i]);
            }

            int oddSum = 0; // 1만 따로 떼어 담는 sum
            int evenSum = 0; // 2만큼 묶어 담는 sum

            for (int i = 0; i < N; i++) {
                evenSum += (max -arr[i]) / 2;
                oddSum += (max - arr[i]) % 2;
            }

        	// 1의 개수랑 2의 개수가 최대한 비슷할 수 있도록 날짜 조정
            while (evenSum > oddSum + 1) {
            	evenSum--;
            	oddSum +=2;
            }
            
            if (oddSum == evenSum) {
            	answer = oddSum * 2;
            } else if (oddSum > evenSum) {
            	// 1이 더 많아서 마지막에 홀수로 끝나는 경우
            	answer = oddSum * 2 - 1;
            } else if (evenSum > oddSum) {
            	// 2가 더 많아서 마지막에 짝수 날로 끝나는 경우
            	answer = evenSum * 2;
            }
 
            sb.append("#").append(t).append(" ").append(answer).append("\n");
        }
        System.out.print(sb);
    }
     
}
