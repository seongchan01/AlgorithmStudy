import java.util.*;
import java.io.*;

public class Solution {
    static int N, maxCores, minWireLen;
    static int[][] map;
    static ArrayList<int[]> coreList;

    static int[] dr = {-1, 0, 1, 0};
    static int[] dc = {0, 1, 0, -1};

    public static void main(String[] args) throws Exception {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        StringBuilder sb = new StringBuilder();
        StringTokenizer st;
        
        int T = Integer.parseInt(br.readLine());

        for(int tc = 1; tc <= T; tc++) {
            N = Integer.parseInt(br.readLine());
            map = new int[N][N];
            coreList = new ArrayList<>();

            for(int i = 0; i < N; i++) {
                st = new StringTokenizer(br.readLine());
                
                for(int j = 0; j < N; j++) {
                    map[i][j] = Integer.parseInt(st.nextToken());
                    
                    // 가장자리가 아닌 내부에 있는 코어만 리스트에 추가
                    if(map[i][j] == 1) {
                        if(i == 0 || i == N-1 || j == 0 || j == N-1) continue;
                        
                        coreList.add(new int[]{i, j});
                    }
                }
            }

            maxCores = 0;
            minWireLen = Integer.MAX_VALUE;

            dfs(0, 0, 0);

            sb.append("#").append(tc).append(" ").append(minWireLen).append("\n");
        }
        
        System.out.print(sb);
    }

    static void dfs(int index, int coreCount, int wireLength) {
        // 모든 코어를 다 확인했을 때 종료
        if(index == coreList.size()) {
        	// 1순위: 코어가 더 많이 연결됨
            if(coreCount > maxCores) {
                maxCores = coreCount;
                minWireLen = wireLength;
            }
            // 2순위: 코어 수는 같은데 전선이 더 짧음
            else if(coreCount == maxCores) {
                minWireLen = Math.min(minWireLen, wireLength);
            }
            return;
        }

        // 남은 코어를 다 합쳐도 기존 최대 코어수보다 작으면 패스
        if(coreCount + (coreList.size() - index) < maxCores) return;

        int[] core = coreList.get(index);
        int r = core[0];
        int c = core[1];
        	
        // 해당 방향으로 전선을 놓을 수 있는지 체크
        for(int d = 0; d < 4; d++) {
            int nr = r, nc = c;
            int len = 0;
            boolean isPossible = true;
            
            while(true) {
                nr += dr[d];
                nc += dc[d];
                
                // 벽에 도달하면 OK
                if(nr < 0 || nr >= N || nc < 0 || nc >= N) break;
                
                // 가는 길에 코어나 전선이 있으면 실패
                if(map[nr][nc] != 0) {
                    isPossible = false;
                    break;
                }
                
                len++;
            }

            // 전선을 놓을 수 있다면 전선 깔고 다음 단계로 넘어가기
            if(isPossible) {
                nr = r; nc = c;
                
                for(int i = 0; i < len; i++) {
                    nr += dr[d];
                    nc += dc[d];
                    
                    map[nr][nc] = 2;
                }

                // 다음 코어로 이동
                dfs(index + 1, coreCount + 1, wireLength + len);

                // 갔다 왔으니 방금 깔았던 전선 다시 지우기
                nr = r; nc = c; 

                for(int i = 0; i < len; i++) {
                    nr += dr[d];
                    nc += dc[d];
                    
                    map[nr][nc] = 0;
                }
            }
        }

        // 현재 코어를 연결하지 않고 그냥 다음 코어로 넘겨보는 경우
        dfs(index + 1, coreCount, wireLength);
    }
}
